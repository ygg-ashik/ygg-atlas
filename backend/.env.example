# ygg-atlas backend configuration

# Own database (sessions, messages, audit log, demo data)
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5433/ygg_atlas

# LLM provider — set exactly one key (Anthropic wins if both are set).
# AGENT_MODEL is optional: defaults to claude-sonnet-4-6 (Anthropic) / gpt-4.1 (OpenAI).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_MODEL=

# Firebase auth (internal users, @yougotagift.com only)
FIREBASE_PROJECT_ID=
ALLOWED_EMAIL_DOMAIN=yougotagift.com
# Dev only: set true to bypass Firebase auth locally (NEVER in production)
AUTH_DISABLED=false
# development | test | production. Unset means production (fail closed): production
# refuses AUTH_DISABLED=true and requires FIREBASE_PROJECT_ID.
# Local dev: set ENVIRONMENT=development in your backend/.env.
ENVIRONMENT=production
# Comma-separated emails created as admins at startup if they have no user yet
# (idempotent, audited). An existing user's role is never changed: use the CLI.
BOOTSTRAP_ADMINS=
# Web sessions are capped server-side from the sign-in time.
SESSION_MAX_AGE_HOURS=24

# Data source plugins (app/sources/<id>/) — a plugin is enabled iff its env is set.
# ALL database credentials must be SELECT-only roles.
# demo: deterministic sample data (defaults to our own Postgres; seed with scripts/seed_demo.py)
APPDB_URL=postgresql+asyncpg://atlas:atlas@localhost:5433/ygg_atlas
# deepsales: B2B portfolio DB (⚠ swap superuser URL for a SELECT-only role)
DEEPSALES_DB_URL_LIVE=
# ga4: enabled when property id + service-account credentials are set
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Guardrails
CHAT_DAILY_MESSAGE_LIMIT=200
AGENT_MAX_TOOL_ROUNDS=6
MAX_INPUT_CHARS=4000

# MCP endpoint auth (static bearer token for internal MCP clients)
ATLAS_MCP_TOKEN=
# MCP is off unless ATLAS_MCP_TOKEN is set. Until per-user MCP auth (phase 4),
# MCP calls run as this service user, under its own grants.
MCP_SERVICE_EMAIL=mcp-shared@atlas.internal

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# HMAC key for pseudonymised breakdown labels (a secret; generate: openssl rand -hex 32).
# Empty means pseudonymised labels are suppressed; production logs an error at startup.
ATLAS_PSEUDONYM_KEY=
