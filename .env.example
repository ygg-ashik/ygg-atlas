# Repo-root .env: read by docker compose for the frontend build args.
# Firebase web config (public, but kept out of git; the secret scanner flags API keys).
# Firebase console -> Project settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ygg-atlas.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ygg-atlas
VITE_FIREBASE_APP_ID=
