# Backend base URL. Leave empty for same-origin requests:
#   - dev: the Vite proxy forwards /api → http://localhost:8081
#   - docker: nginx proxies /api → backend:8081
# Set an absolute URL (e.g. http://localhost:8081) to bypass the proxy.
VITE_BACKEND_URL=

# Firebase web app config (Auth only — no Firestore).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
